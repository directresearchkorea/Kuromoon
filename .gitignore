# Kuromoon Git Exclusion Rules

# Security & Secret Keys (CRITICAL: NEVER COMMIT)
.env
*.env
web/.env

# Node Dependencies
node_modules/
web/node_modules/

# Pipeline Temporary & Raw Internal Data
web/data/raw_inputs.json
web/data/refined_places.json
web/data/review_needed.json
web/data/discarded_places.json
web/data/pipeline_log.json

# Local Admin Dashboard & Backups (Private, never upload to Git)
*dashboard*.html
web/public/dashboard*.html
*.bak
*.bak.*
web/*.bak.js

# Temporary & Test Scripts
web/temp*.js
web/test-*.js
web/test-*.html

# IDE & OS Temp Files
.DS_Store
Thumbs.db
.vscode/
.idea/

