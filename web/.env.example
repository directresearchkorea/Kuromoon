# Kuromoon Environment Variables Sample Template
# Copy this file to .env and fill in your confidential API keys.

# Gemini API Key for AI data extraction & trend discovery
GEMINI_API_KEY=your_gemini_api_key_here

# Naver API Keys for DataLab & Blog Search
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# Public Data Portal API Key (공공데이터포털)
PUBLIC_DATA_API_KEY=your_public_data_api_key_here

# Kakao JS Key for Map & Sharing
KAKAO_JS_KEY=your_kakao_js_key_here

# Google Analytics Measurement ID
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Email Notification Credentials (Optional)
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password_here
EMAIL_TO=recipient_email@example.com
